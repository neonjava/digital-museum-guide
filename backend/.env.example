# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty for embedded MongoDB memory server during local development, or provide MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/museum_guide?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret
JWT_SECRET=REDACTED_JWT_SECRET

# Media Storage Provider ('cloudinary' or 'local')
# When using Cloudinary, images/audio/videos are stored in Cloudinary CDN.
# When empty or 'local', media is saved to backend /uploads directory.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
