{
  "name": "digital-museum-guide-platform",
  "version": "1.0.0",
  "description": "Modern Digital Museum QR Guide Platform with Audio Narrations, Video Documentaries, QR Placard Generation, and Android App",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:all": "npm run build --workspaces",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "start": "npm start --workspace=backend"
  },
  "keywords": [
    "digital-museum",
    "qr-guide",
    "museum-audio-guide",
    "react",
    "express",
    "mongodb",
    "capacitor",
    "android"
  ],
  "author": "Digital Museum Guide Platform",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
